# Flask
FLASK_APP=main.py
FLASK_ENV=development          # development | production
SECRET_KEY=change-me           # python -c "import secrets; print(secrets.token_hex(32))"
LOG_LEVEL=INFO

# Neon Postgres — copy the connection string from the Neon console (Connect > Pooled connection)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Set SESSION_COOKIE_SAMESITE=None and SESSION_COOKIE_SECURE=true when frontends live on another domain
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Mail (Gmail requires an app password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
